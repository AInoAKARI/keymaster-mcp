{
  "name": "@akari-os/keymaster-mcp",
  "version": "1.1.0",
  "description": "Non-disclosing MCP server for Vault credential discovery, availability, and health checks via Keymaster.",
  "mcpName": "io.github.ainoakari/keymaster-mcp",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "keymaster-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check:release": "node scripts/check-release.mjs",
    "test": "npm run build && node --test test/*.test.mjs && npm run check:release",
    "demo:local": "npm run build && node ../examples/local-demo/demo.mjs",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vault",
    "secrets",
    "keymaster",
    "akari",
    "hashicorp-vault",
    "ai-agent",
    "claude",
    "secret-management",
    "api-keys",
    "security",
    "non-disclosing",
    "zero-env"
  ],
  "author": "AInoAKARI <aino-akari@ai-akari.ai> (https://ai-akari.ai)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://ai-akari.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AInoAKARI/keymaster-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/AInoAKARI/keymaster-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "server.json",
    ".well-known/"
  ]
}
